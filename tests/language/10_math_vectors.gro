print(Math.sqrt(16), Math.abs(-3), Math.floor(2.7), Math.ceil(2.1), Math.round(2.5))
print(Math.min(3, 1, 2), Math.max(3, 1, 2), Math.clamp(5, 0, 3), Math.lerp(0, 10, 0.25))
print(Math.round(Math.sin(Math.PI / 2)))
r = Math.random()
print(r >= 0 and r < 1)
n = Math.random_range(5, 6)
print(n >= 5 and n < 6)
v = Vector3.new(1, 2, 2)
print(v, v.x, v.length())
print(v + Vector3.new(1, 1, 1), v * 2, v - Vector3.UP)
print(Vector3.new(3, 0, 0).normalized())
print(Vector3.new(1, 0, 0).cross(Vector3.new(0, 1, 0)))
print(Vector3.new(1, 0, 0).dot(Vector3.new(0, 1, 0)))
print(Vector3.ZERO.distance_to(Vector3.new(0, 3, 4)))
print(v.with_y(0), -v)
print(Vector3.new(0, 0, 0).lerp(Vector3.new(10, 0, 0), 0.5))
c = Color.new(1, 0.5, 0)
print(c, c.g, Color.hex("#ff0000"))
w = Vector2.new(3, 4)
print(w, w.length())
