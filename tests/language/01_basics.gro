# Numbers, strings, booleans, nil
print(1 + 2 * 3)
print(10 / 4)
print(7 % 3, -7 % 3)
print(2 ** 10)
print(-2 ** 2)
print(0.1 + 0.2)
print("hello" + " " + "world")
print("ab" * 3)
print(true, false, nil)
print(inspect(nil), inspect("q\"uote"))
print(1_000_000)
x = 5
x += 2
x *= 3
x -= 1
x /= 4
print(x)
print(type(1), type("s"), type(:sym), type(nil), type([]), type({}))
